# Copy this file to .env and set unique values. Never commit .env.
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://pricewatch:REPLACE_WITH_THE_POSTGRES_PASSWORD@127.0.0.1:5432/pricewatch
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TEMPORARY_SERVICE_ROLE_KEY_FOR_ONE_TIME_MIGRATION_ONLY
PRICEWATCH_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
